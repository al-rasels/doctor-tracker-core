{
  "name": "doctor-tracker-monolith",
  "version": "1.0.0",
  "private": true,
  "description": "Doctor Tracker - Modular Monolith with separate Next.js Frontend and Node.js Express Backend",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "start:backend": "npm run start --workspace=backend",
    "start:frontend": "npm run start --workspace=frontend",
    "seed": "npm run seed --workspace=backend",
    "typecheck": "npm run typecheck --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
